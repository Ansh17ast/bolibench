# ==============================================================================
# BoliBench Environment Configuration (.env)
# ==============================================================================
# Copy this file to .env and replace the placeholder values with your credentials.
# DO NOT commit your actual .env file to version control.

# Gnani Prisma API Credentials
# Obtain your key from the Gnani Voice Console: https://app.gnani.ai/voice
GNANI_API_KEY=your_gnani_api_key_here

# Gnani STT API Base Endpoint (Verified Production v3 endpoint)
GNANI_BASE_URL=https://api.vachana.ai/stt/v3

# Network and Timeout Settings (in seconds)
GNANI_REQUEST_TIMEOUT_SECONDS=30.0

# Upload Constraints (25 MB max limit)
MAX_AUDIO_SIZE_BYTES=26214400

# Application Environment (development, testing, production)
APP_ENV=development

# Server Settings
HOST=127.0.0.1
PORT=8000

# Live Evaluation Credit Protection (Strictly false by default)
# When set to false, live evaluation endpoints reject all requests (403 Forbidden)
# before reading uploads or calling Gnani Prisma API.
# Must be deliberately enabled (LIVE_EVALUATION_ENABLED=true) ONLY for a controlled,
# operator-authorized local experiment to prevent accidental credit consumption.
LIVE_EVALUATION_ENABLED=false
